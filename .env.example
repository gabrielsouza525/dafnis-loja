# Copie para .env e ajuste. Nunca versione o .env.

APP_NAME="Dafnis Treinamentos"
APP_ENV=local                  # local | production
APP_DEBUG=true                 # false em produção
APP_URL=http://localhost:8000  # URL pública, sem barra no final (links de e-mail, sitemap, retorno do Mercado Pago)
APP_TIMEZONE=America/Sao_Paulo

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dafnis
DB_USERNAME=root
DB_PASSWORD=

SESSION_LIFETIME=120           # minutos de inatividade até expirar
SESSION_SECURE=false           # true em produção (HTTPS)

# Pagamento ---------------------------------------------------------------
# Sem MP_ACCESS_TOKEN a loja funciona em modo manual: o pedido fica
# "aguardando pagamento" e a equipe dá a baixa no painel. Nada é cobrado sozinho.
PAYMENT_GATEWAY=mercadopago
MP_ACCESS_TOKEN=               # Mercado Pago › Suas integrações › Credenciais de produção › Access Token
MP_WEBHOOK_SECRET=             # Mercado Pago › Webhooks › chave secreta (assinatura das notificações)
MP_SANDBOX=false               # true usa o sandbox_init_point (credenciais de teste)

# E-mail (confirmações de pedido, acesso liberado, certificado, senha) -----
MAIL_DRIVER=log                # log = grava em storage/mail | smtp = envia de verdade
MAIL_HOST=
MAIL_PORT=587
MAIL_ENCRYPTION=tls            # tls (587) | ssl (465)
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Dafnis Treinamentos"
MAIL_ADMIN_ADDRESS=            # quem recebe os avisos de novos pedidos e contatos (vazio = e-mail de contato da loja)

UPLOAD_MAX_MB=8

# Instalação pela web em hospedagem sem SSH (/instalar). Deixe vazio para desativar.
INSTALL_TOKEN=
